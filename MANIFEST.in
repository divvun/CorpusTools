include *.txt
recursive-include docs *.txt
recursive-include src/corpustools *
prune tests
prune docs/.venv
prune CorpusTools.egg-info
prune corpustools.egg-info
prune src/corpustools.egg-info
prune src/corpustools/.mypy_cache
prune src/corpustools/.pytest_cache
prune src/corpustools/__pycache__
global-exclude *.py[cod]
global-exclude .DS_Store
